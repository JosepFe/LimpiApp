{
  "name": "limpiapp",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "tokens": "node scripts/sync-tokens.mjs",
    "lint": "ng lint --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "test": "ng test --watch=false --coverage",
    "test:node": "vitest run -c vitest.node.config.mts",
    "build": "ng build && vitest run -c vitest.build.config.mts",
    "qa": "npm run lint && npm run typecheck && npm test && npm run test:node && npm run build && npm run e2e && npm run parity",
    "prototype:sync": "node scripts/prototype-sync.mjs",
    "e2e": "playwright test --project=e2e",
    "parity": "node scripts/prototype-sync.mjs --check && playwright test --project=parity --project=parity-mobile --pass-with-no-tests"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/inter": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "sass": "^1.104.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
