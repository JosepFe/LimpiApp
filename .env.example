# Copy to .env (chmod 600). Never commit .env.
POSTGRES_PASSWORD=change-me
PUBLIC_URL=http://127.0.0.1:8090

# Google OAuth (web client). Redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP. Local: leave empty to use Mailpit (docker compose --profile dev).
# Production: Gmail with an app password (smtp.gmail.com:587).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
